# Copy to .env and fill in
# From the Android emulator, the host machine is 10.0.2.2. On a real phone use your computer's LAN IP or a deployed https URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# The WEB OAuth client ID (also listed in the API's GOOGLE_CLIENT_IDS). The Android client ID is matched by package name + SHA-1, not set here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
